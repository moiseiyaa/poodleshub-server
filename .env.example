# Database
DATABASE_URL=postgresql://user:password@localhost:5432/poodleshub

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=puppyhubusa@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=PuppyHub USA <noreply@puppyhubusa.com>

# Admin Configuration
ADMIN_EMAIL=admin@puppyhubusa.com
ADMIN_SECRET_KEY=your-secret-key-here

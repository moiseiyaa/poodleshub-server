generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id          String    @id
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  role        String    @default("admin")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
}

model Application {
  id                   String   @id
  firstName            String
  lastName             String
  email                String
  mobileNumber         String
  address              String
  city                 String
  state                String
  zipCode              String
  outsideUS            Boolean  @default(false)
  textAlerts           Boolean  @default(false)
  referralSource       String?
  breedChoices         Json
  preferredSizes       String[]
  preferredGender      String
  preferredColors      String[]
  preferredCoatTypes   String[]
  activityLevel        String
  pickupLocation       String
  secondPickupLocation String?
  deliveryMethod       String
  paymentMethod        String?
  depositAmount        Int?
  otherPets            Boolean
  petTypes             String?
  allergies            String?
  hasChildren          Boolean
  childrenAges         String?
  hasFence             Boolean
  alternativeExercise  String?
  lifestyle            String
  typicalDay           String
  whyGoodFit           String
  firstDog             Boolean
  previousPuppies      Int      @default(0)
  interestedInTraining Boolean
  spayNeuterAgreement  Boolean
  optInCommunications  Boolean  @default(false)
  welcomeCall          Boolean  @default(false)
  status               String   @default("submitted")
  rejectionReason      String?
  puppyId              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  displayId            String   @unique
  Puppy                Puppy?   @relation(fields: [puppyId], references: [id])

  @@index([displayId])
  @@index([email])
  @@index([status])
}

model Breed {
  id              String   @id
  name            String   @unique
  description     String?
  characteristics String?
  averageSize     String?
  temperament     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model EmailLog {
  id        String   @id
  to        String
  subject   String
  type      String
  status    String   @default("sent")
  error     String?
  createdAt DateTime @default(now())
}

model Puppy {
  id           String        @id
  name         String
  breed        String
  gender       String
  birthDate    DateTime
  price        Float
  status       String        @default("available")
  color        String
  generation   String
  vaccinations String[]
  notes        String?
  images       String[]
  sireId       String?
  damId        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  damImage     String?
  Application  Application[]
  Reservation  Reservation[]

  @@index([breed])
  @@index([status])
}

model Reservation {
  id            String   @id
  puppyId       String
  customerEmail String
  customerName  String
  status        String   @default("active")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Puppy         Puppy    @relation(fields: [puppyId], references: [id], onDelete: Cascade)

  @@index([customerEmail])
  @@index([puppyId])
}

model SeoMeta {
  id                String    @id
  entityType        String
  entityId          String
  metaTitle         String?
  metaDescription   String?
  focusKeywords     String[]
  slug              String?   @unique
  canonicalUrl      String?
  robots            String    @default("INDEX")
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  schemaType        String?
  customMeta        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  
  @@index([entityId])
  @@index([entityType])
  @@index([slug])
}

model Testimonial {
  id         String    @id
  name       String
  location   String?
  rating     Int
  text       String
  puppyName  String?
  puppyBreed String?
  initials   String?
  date       DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
}

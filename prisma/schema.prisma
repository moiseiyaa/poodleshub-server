// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Puppy {
  id            String   @id @default(cuid())
  name          String
  breed         String
  gender        String   // 'male' | 'female'
  birthDate     DateTime
  price         Float
  status        String   @default("available") // 'available' | 'reserved' | 'adopted'
  color         String
  generation    String   // F1, F1b, F2, etc.
  vaccinations  String[] // Array of vaccination names
  notes         String?
  images        String[] // Array of image URLs
  
  // Parent information
  sireId        String?
  damId         String?
  
  // Relations
  applications  Application[]
  reservations  Reservation[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([breed])
  @@index([status])
}

model Breed {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  characteristics String?
  averageSize   String?
  temperament   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Application {
  id                    String   @id @default(cuid())
  
  // Step 1: Basic Information
  firstName             String
  lastName              String
  email                 String
  mobileNumber          String
  address               String
  city                  String
  state                 String
  zipCode               String
  outsideUS             Boolean  @default(false)
  textAlerts            Boolean  @default(false)
  referralSource        String?
  
  // Step 2: Puppy Preferences
  breedChoices          Json     // Array of { priority: number, breed: string }
  preferredSizes        String[]
  preferredGender       String
  preferredColors       String[]
  preferredCoatTypes    String[]
  activityLevel         String
  pickupLocation        String
  secondPickupLocation  String?
  deliveryMethod        String   // 'pickup' | 'delivery'
  paymentMethod         String?
  depositAmount         Int?
  
  // Step 3: Household Information
  otherPets             Boolean
  petTypes              String?
  allergies             String?
  hasChildren           Boolean
  childrenAges          String?
  hasFence              Boolean
  alternativeExercise   String?
  lifestyle             String
  typicalDay            String
  whyGoodFit            String
  firstDog              Boolean
  previousPuppies       Int      @default(0)
  interestedInTraining  Boolean
  
  // Step 4: Agreements
  spayNeuterAgreement   Boolean
  optInCommunications   Boolean  @default(false)
  welcomeCall           Boolean  @default(false)
  
  // Status and tracking
  status                String   @default("submitted") // 'submitted' | 'under_review' | 'approved' | 'rejected'
  rejectionReason       String?
  
  // Relations
  puppyId               String?
  puppy                 Puppy?   @relation(fields: [puppyId], references: [id])
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([email])
  @@index([status])
}

model Reservation {
  id                String   @id @default(cuid())
  puppyId           String
  puppy             Puppy    @relation(fields: [puppyId], references: [id], onDelete: Cascade)
  
  // Customer info (from application)
  customerEmail     String
  customerName      String
  
  status            String   @default("active") // 'active' | 'completed' | 'cancelled'
  expiresAt         DateTime
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([puppyId])
  @@index([customerEmail])
}

model AdminUser {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String   // Hashed password
  firstName         String
  lastName          String
  role              String   @default("admin") // 'admin' | 'super_admin'
  isActive          Boolean  @default(true)
  
  lastLoginAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailLog {
  id                String   @id @default(cuid())
  to                String
  subject           String
  type              String   // 'application_confirmation' | 'status_update' | 'notification'
  status            String   @default("sent") // 'sent' | 'failed'
  error             String?
  
  createdAt         DateTime @default(now())
}
